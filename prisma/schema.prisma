// CraftConnect — Slice 1 schema
// Covers: identity, provider profiles, categories, design requests, quotations.
// Orders, payments, messaging and reviews come in later slices.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CONSUMER
  PROVIDER
  ADMIN
}

enum RequestStatus {
  OPEN // accepting quotations
  QUOTED // at least one quotation received
  AWARDED // consumer picked a provider
  CANCELLED // withdrawn by the consumer
  EXPIRED // deadline passed with no award
}

enum QuotationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN // pulled by the provider before a decision
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  name          String
  emailVerified DateTime?
  roles         UserRole[] @default([CONSUMER])
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  providerProfile ProviderProfile?
  designRequests  DesignRequest[]

  @@index([deletedAt])
}

model ProviderProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  businessName String
  slug         String    @unique
  bio          String?
  city         String
  country      String    @default("IN")
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotations Quotation[]

  @@index([city])
  @@index([verifiedAt])
}

// ---------------------------------------------------------------------------
// Taxonomy
// ---------------------------------------------------------------------------

model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  parentId String?

  parent         Category?       @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[]      @relation("CategoryTree")
  designRequests DesignRequest[]

  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Custom design requests
// ---------------------------------------------------------------------------

model DesignRequest {
  id                 String        @id @default(cuid())
  consumerId         String
  categoryId         String
  title              String
  description        String
  budgetAmount       Decimal?      @db.Decimal(12, 2)
  currency           String        @default("INR")
  quantity           Int           @default(1)
  deadline           DateTime?
  materialPreference String?
  colorPreference    String?
  dimensions         String?
  notes              String?
  status             RequestStatus @default(OPEN)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  consumer    User                @relation(fields: [consumerId], references: [id], onDelete: Restrict)
  category    Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attachments RequestAttachment[]
  quotations  Quotation[]

  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([consumerId])
}

model RequestAttachment {
  id        String   @id @default(cuid())
  requestId String
  url       String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  request DesignRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Quotations
// ---------------------------------------------------------------------------

model Quotation {
  id                 String          @id @default(cuid())
  requestId          String
  providerId         String
  itemAmount         Decimal         @db.Decimal(12, 2)
  shippingAmount     Decimal         @default(0) @db.Decimal(12, 2)
  currency           String          @default("INR")
  estimatedDays      Int
  suggestedMaterials String?
  manufacturingNotes String?
  status             QuotationStatus @default(PENDING)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  request  DesignRequest   @relation(fields: [requestId], references: [id], onDelete: Restrict)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([requestId, providerId])
  @@index([providerId, status])
  @@index([requestId, status])
}
